{
  "name": "hia-html-validator",
  "version": "1.6.1",
  "private": true,
  "description": "Command-line rendered HTML, SVG and maths checks, with full B35 lesson-deck validation",
  "repository": { "type": "git", "url": "git+https://github.com/DannyDOK/hia-html-validator.git" },
  "bin": { "hia-html-validator": "bin/hia-html-validator.cjs", "html-validate-b35": "bin/hia-html-validator.cjs", "b35-validate": "bin/hia-html-validator.cjs" },
  "engines": { "node": ">=20" },
  "files": ["bin/", "src/", "config/", "templates/", "docs/", "tests/", "scripts/", "README.md", "AGENTS.md", "html-cli.cjs", "validate-b35.cjs"],
  "scripts": {
    "validate": "node validate-b35.cjs",
    "validate:html": "node bin/hia-html-validator.cjs",
    "test": "node scripts/test.cjs",
    "test:svg": "node tests/test-svg-formulas.cjs",
    "test:styles": "node tests/test-formula-styles.cjs",
    "test:models": "node tests/test-visual-models.cjs",
    "test:visual-review": "node tests/test-visual-review.cjs",
    "test:page-pairs": "node tests/test-page-pairs.cjs",
    "test:complementary": "node tests/test-complementary.cjs",
    "test:cli": "node tests/test-cli.cjs",
    "test:structure": "node tests/test-structure.cjs",
    "test:package": "node tests/test-package.cjs",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
